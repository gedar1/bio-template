# Modo del dashboard. Debe coincidir con DEPLOYMENT_MODE del backend.
# studio = varios clientes con gestión de plataforma (default)
# single = un solo negocio, sin pestaña de plataforma
VITE_DEPLOYMENT_MODE=studio

# Nombre que aparece en el encabezado del dashboard (default: BioCore)
VITE_BRAND_NAME=BioCore

# Tenant del dashboard. En single debe coincidir con TENANT_ID del backend.
# En studio es el tenant con el que arranca el chat (default: default).
VITE_TENANT_ID=default
