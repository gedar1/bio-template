[
  {
    "id": "db-backup",
    "name": "Database Backup",
    "category": "memory",
    "profile": "dev",
    "description": "Periodic database backup via SQL dump",
    "expectedOutcome": "Genera un dump SQL de la tabla especificada en la ruta de salida",
    "steps": ["mutate:memory", "db_query", "mutate:filesystem", "write_file"],
    "parameters": [
      {
        "key": "table",
        "label": "Table name",
        "type": "string",
        "required": true,
        "placeholder": "users"
      },
      {
        "key": "outputPath",
        "label": "Output path",
        "type": "string",
        "required": true,
        "placeholder": "./backups/"
      }
    ],
    "defaultIntervalMs": 3600000,
    "usesLLM": false
  },
  {
