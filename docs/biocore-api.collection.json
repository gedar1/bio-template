{
  "info": {
    "name": "BioCore API",
    "description": "BioCore Semantic Routing & Reflex Management",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Get JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"test-secret-dev\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/platform/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "platform",
                "auth",
                "login"
              ]
            },
            "description": "Obtener JWT token\n\n⚠️ EJECUTA ESTO PRIMERO\n\n1. Copia el token de la respuesta\n2. Pégalo en las variables globales: jwt_token\n3. Luego ejecuta los otros requests"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ]
}
