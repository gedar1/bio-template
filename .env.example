# ════════════════════════════════════════════
# BioCore — Variables de entorno
# Copia este archivo a .env y completa los valores
# ════════════════════════════════════════════

# ── LLM Providers ──────────────────────────
# Al menos una key es requerida para funciones con LLM.
# El sistema funciona sin LLM para tareas automáticas (Reflex, Scheduler).

# Gemini (Google) — Proveedor primario recomendado
GOOGLE_API_KEY=tu-google-api-key-aqui

# Claude (Anthropic) — Fallback 1
ANTHROPIC_API_KEY=tu-anthropic-api-key-aqui

# NVIDIA NIM — Fallback 2 (especializado en tool calling)
# NVIDIA_API_KEY=nvapi-tu-nvidia-api-key-aqui

# ── TypeSafe AI (Jev) ───────────────────────
# Pre-router de célula + guardrail + selección semántica de modelo.
# OPCIONAL: sin esta key los tres sistemas degradan al comportamiento base.
# Obtén tu key en: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=sk-tu-typesafe-api-key-aqui

# ── Perfil del dominio ──────────────────────
# Nombre del perfil definido en packages/domain/src/config/profile.ts
# Cambia "domain" al nombre que le diste a tu caso de uso.
TENANT_PROFILE=domain

# ── Base de datos ───────────────────────────
DATABASE_TYPE=sqlite
DATABASE_PATH=./biocore.db
# DATABASE_DIR=./data   # directorio para BDs multi-tenant

# ── Servidor ────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
DASHBOARD_ROLE=admin   # admin | operator | viewer

# ── Email (opcional) ────────────────────────
# GMAIL_USER=tu-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Seguridad (opcional) ────────────────────
# API_SECRET=   # vacío = sin autenticación (modo desarrollo)
